# ===================================================================
# TripTandem Client Environment Configuration
# ===================================================================

# 1. Google OAuth 2.0 Web Client ID
# Obtain from https://console.cloud.google.com/apis/credentials
# In Google Console, add your live Vercel domain to "Authorized JavaScript origins":
# e.g., https://your-triptandem.vercel.app
VITE_GOOGLE_CLIENT_ID=

# 2. Live Backend API URL
# For Vercel Production (pointing to your live cloud server):
# VITE_API_URL=https://your-triptandem-server.onrender.com/api
# For Local Development (Vite reverse proxy):
VITE_API_URL=/api

# 3. Live WebSocket URL for Socket.IO
# For Production real-time collaboration & duel voting:
# VITE_SOCKET_URL=https://your-triptandem-server.onrender.com
# Defaults to same origin host as VITE_API_URL if omitted
VITE_SOCKET_URL=

# 4. Third-Party Travel APIs (Optional Client-Side Keys)
# Geoapify Places Autocomplete API Key
VITE_GEOAPIFY_API_KEY=

# Google Maps / Places API Key (Photos & Geocoding)
VITE_GOOGLE_MAPS_API_KEY=

# 5. Fast AI Travel Concierge Models (Cascading Fallback Order)
# Any or all can be provided. System automatically auto-cascades to the fastest available model:
# Tier 1 (Fastest, ~200ms): Google Gemini 2.0 Flash (Free tier at https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=

# Tier 2 (Ultra-fast, ~350ms): OpenAI GPT-4o Mini (from https://platform.openai.com/api-keys)
VITE_OPENAI_API_KEY=

# Tier 3 (Multi-model router): OpenRouter API (from https://openrouter.ai/keys)
VITE_OPENROUTER_API_KEY=

# Tier 4 (Always Active): TripTandem Grounded Engine (100% Guaranteed 0ms offline fallback)
