{
  "name": "triptandem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client install && npm --prefix client run build",
    "dev": "node dev.js",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "test": "node scripts/verify_prd_compliance.js",
    "test:docker": "node scripts/verify_docker_prerequisites.js",
    "test:benchmark": "node server/benchmark.js",
    "test:precision": "node scripts/verify_prd_compliance.js",
    "install:all": "npm --prefix server install && npm --prefix client install"
  }
}
