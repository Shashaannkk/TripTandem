# ===================================================================
# TripTandem Server Environment Configuration (Live Production & Local)
# ===================================================================

# 1. Server Port & Environment
PORT=3001
NODE_ENV=production

# 2. JWT Secret for Cryptographic Session Signing
# Generate a secure 32+ character random secret for production
JWT_SECRET=replace_with_a_long_random_production_jwt_secret

# 3. Allowed Frontend CORS / Origin Domains
# In production, set to your live Vercel domain (comma-separated if multiple):
# e.g., https://triptandem.vercel.app,http://localhost:5173
CLIENT_URL=https://your-triptandem.vercel.app

# 4. Google OAuth 2.0 Credentials (User Authentication)
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===================================================================
# Travel Data Providers (Adapter Hub)
# The server will seamlessly fallback to curated local seed data if any key is empty.
# ===================================================================

# Geoapify Places API (Primary Place & POI Discovery)
# Obtain from https://www.geoapify.com/
GEOAPIFY_API_KEY=

# Amadeus for Developers API (Hotel Offers & Live Room Rates)
# Obtain from https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Google Maps / Places API (Place Photos, Reviews & Ratings)
# Obtain from https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# ===================================================================
# Fast AI Travel Concierge Models (Server-Side Secure - Hidden from Browser)
# ===================================================================
# Option A: Google Gemini 2.0 Flash (Fastest, ~200ms latency)
GEMINI_API_KEY=

# Option B: OpenAI GPT-4o Mini (Ultra-fast, ~350ms latency)
OPENAI_API_KEY=

# Option C: OpenRouter Multi-Model Router (Aggregator)
OPENROUTER_API_KEY=

